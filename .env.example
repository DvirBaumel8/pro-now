# Copy to apps/api/.env for local development (the API and the Prisma CLI
# run with apps/api as their working directory). Never commit the real .env.
# `docker compose up -d` starts everything the values below point at.
NODE_ENV=local
PORT=4000

DATABASE_URL=postgresql://pronow:pronow_local_only@localhost:54320/pronow
# Optional: only a latency shortcut for accepting offers. The MVP runs without it.
# REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-local-dev-secret-please

# Local stand-ins for the Phase 2 vendors (docker-compose.yml,
# /docs/21-PRODUCTION-PLAN.md §0). Staging/production refuse to boot with these.
PUBLIC_URL=http://localhost:4000
# S3 API (SeaweedFS locally, Cloudflare R2 in Phase 2)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=pronow-media
S3_ACCESS_KEY_ID=pronow_local
S3_SECRET_ACCESS_KEY=pronow_local_only_secret
# SMTP (Mailpit locally, UI at http://localhost:8025; Resend in Phase 2)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="PRO NOW <no-reply@pronow.test>"
# Google sign-in (mock OpenID issuer locally; real Google needs no issuer override)
GOOGLE_CLIENT_ID=pronow-local
GOOGLE_CLIENT_SECRET=pronow-local-secret
GOOGLE_ISSUER_URL=http://localhost:8089/google

# Vendor flags — sandbox only until a business decision is made.
# See /docs/18-ROADMAP.md §Open Decisions.
PAYMENT_PROVIDER=sandbox
IDENTITY_PROVIDER=sandbox
MAPS_PROVIDER=sandbox
EXTERNAL_REPUTATION_PROVIDER=sandbox

# GOOGLE_MAPS_API_KEY=

DISPATCH_OFFER_TIMEOUT_SECONDS=30
# How long to keep looking before telling the customer nobody is available.
# Unconfirmed — see /docs/18-ROADMAP.md §Open decisions.
DISPATCH_SEARCH_DEADLINE_SECONDS=300
DISPATCH_GEO_PREFILTER_KM=8
LOCATION_FRESHNESS_THRESHOLD_SECONDS=90

# Browser front ends allowed to call this API, comma-separated. Empty is
# correct for a deployment that has none. In NODE_ENV=local, private
# network origins (localhost / 10.x / 192.168.x / 172.16-31.x) are also
# allowed so the design preview can be read from a phone on the same
# Wi-Fi. See apps/api/src/plugins/cors.ts.
CORS_ORIGINS=
