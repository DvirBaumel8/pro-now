{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "node20",
    "moduleResolution": "node16",
    // An application, not a library: nothing consumes its .d.ts files, and
    // Better Auth's inferred types are not nameable from here.
    "declaration": false
  },
  "include": ["src"]
}
