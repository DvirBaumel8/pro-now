{
  "name": "pro-now",
  "private": true,
  "version": "0.1.0",
  "description": "PRO NOW — real-time ONLINE-FIRST / NOW-FIRST mobile services marketplace monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "tools/design-preview/lib/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:web": "npm run dev -w apps/web",
    "dev:app": "node scripts/dev-app.mjs",
    "dev:customer": "npm run start -w apps/customer-mobile",
    "dev:pro": "npm run start -w apps/pro-mobile",
    "build": "npm run build --workspaces --if-present",
    "lint": "node scripts/check-type-scale.mjs && node scripts/check-demo-isolation.mjs && node scripts/verify-navigation.mjs && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint:product": "node scripts/check-type-scale.mjs && node scripts/check-demo-isolation.mjs && node scripts/verify-navigation.mjs && npm run lint --if-present -w apps -w packages",
    "typecheck:product": "npm run typecheck --if-present -w apps -w packages",
    "test:product": "npm run test --if-present -w apps -w packages",
    "check:demo": "npm run lint --if-present -w tools/design-preview -w tools/design-preview/lib/types -w tools/design-preview/lib/ui && npm run typecheck --if-present -w tools/design-preview -w tools/design-preview/lib/types -w tools/design-preview/lib/ui && npm run test --if-present -w tools/design-preview -w tools/design-preview/lib/types -w tools/design-preview/lib/ui && npm run preview:build",
    "test:int": "npm run test:int -w apps/api",
    "test:e2e": "npm run e2e -w apps/web",
    "parity": "npm run parity -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:seed:dev": "npm run db:seed:dev -w apps/api",
    "dev:pulse": "npm run dev:pulse -w apps/api",
    "audit:shipped": "node scripts/audit-shipped.mjs",
    "drill:backup": "node scripts/backup-drill.mjs",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "verify:journey": "npm run db:seed:dev && node scripts/verify-journey.mjs",
    "verify:demo-isolation": "node scripts/check-demo-isolation.mjs",
    "verify:navigation": "node scripts/verify-navigation.mjs",
    "art:brief": "node scripts/art-brief.mjs",
    "preview:design": "npm run dev -w @pro-now/design-preview",
    "preview:build": "npm run build -w @pro-now/design-preview",
    "db:ddl": "echo 'db:ddl is retired: 0_init is a frozen baseline and regenerating it would fold later migrations into it. Schema changes are Prisma migrations: prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script (docs/21 W1).' && exit 1",
    "db:drift": "npm run db:drift -w apps/api",
    "verify:a11y": "node tools/design-preview/audit.mjs",
    "verify:screens": "node tools/design-preview/sweep.mjs",
    "verify:game": "node tools/design-preview/game.mjs",
    "verify:handover": "node tools/design-preview/handover.mjs",
    "verify:plan": "node tools/design-preview/plan-scale.mjs",
    "verify:faces": "node tools/design-preview/faces.mjs",
    "verify:quote": "node tools/design-preview/quote-price.mjs",
    "verify:type-scale": "node scripts/check-type-scale.mjs",
    "verify:silhouettes": "node tools/design-preview/measure-silhouettes.mjs",
    "verify:geo": "node tools/design-preview/verify-geo.mjs tools/design-preview/geo/fixture_grid.json",
    "geo:fetch": "node tools/design-preview/fetch-geo.mjs",
    "geo:fixture": "node tools/design-preview/make-fixture-geo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "esbuild": "^0.28.2",
    "globals": "^15.15.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "react-native-svg": "15.2.0"
  }
}
