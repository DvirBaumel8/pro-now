{
  "name": "pro-now",
  "private": true,
  "version": "0.1.0",
  "description": "PRO NOW — real-time ONLINE-FIRST / NOW-FIRST mobile services marketplace monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:customer": "npm run start -w apps/customer-mobile",
    "dev:pro": "npm run start -w apps/pro-mobile",
    "build": "npm run build --workspaces --if-present",
    "lint": "node scripts/check-type-scale.mjs && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "verify:domain": "tsx scripts/verify-domain-logic.ts",
    "verify:rowlock": "tsx scripts/verify-row-lock.ts",
    "preview:design": "npm run dev -w @pro-now/design-preview",
    "preview:build": "npm run build -w @pro-now/design-preview",
    "db:ddl": "python3 tools/prisma-ddl/generate.py apps/api/prisma/migrations/0_init/migration.sql",
    "db:verify": "python3 tools/prisma-ddl/verify.py",
    "verify:a11y": "node tools/design-preview/audit.mjs",
    "verify:screens": "node tools/design-preview/sweep.mjs",
    "verify:game": "node tools/design-preview/game.mjs",
    "verify:type-scale": "node scripts/check-type-scale.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20"
  }
}
